generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("CUSTOMER")
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  inventoryMovements InventoryMovement[] @relation("InventoryActor")
  passwordResetTokens PasswordResetToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  active      Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int
  compareAt   Int?
  stock       Int      @default(0)
  sku         String   @unique
  images      String   @db.Text
  colors      String?  @db.Text
  sizes       String?  @db.Text
  colorImages String?  @db.Text
  metal       String?
  occasion    String?
  isFeatured  Boolean  @default(false)
  isNew       Boolean  @default(false)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  reviews     Review[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  active      Boolean  @default(true)
  position    Int      @default(0)
  lowStockAt  Int      @default(5)
  inventoryMovements InventoryMovement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  trackingCode      String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  email             String
  phone             String
  address           String
  total             Int
  status            String   @default("PENDING")
  razorpayOrderId   String?
  razorpayPaymentId String?
  items             OrderItem[]
  paymentStatus     String      @default("UNPAID")
  paymentMethod     String?
  notes             String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
  color     String?
  size      String?
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String
  body      String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  percent   Int
  active    Boolean  @default(true)
  expiresAt DateTime?
}

model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  actorId     String?
  actor       User?    @relation("InventoryActor", fields: [actorId], references: [id])
  quantity    Int
  reason      String
  reference   String?
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}
